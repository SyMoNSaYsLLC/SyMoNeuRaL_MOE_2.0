# Copy to .env or export before scripts/start.sh.
SYMON_SERVICE_NAME=symoneural_moe
SYMON_BIND_HOST=0.0.0.0
SYMON_BIND_PORT=8000
SYMON_DEVICE=cuda

# Flagship backend.
SYMON_TEXT_BACKEND=vllm
SYMON_VISION_BACKEND=vllm
SYMON_IMAGE_BACKEND=diffusers

# Production default is local-only. Set to 1 only while bootstrapping downloads.
SYMON_ALLOW_REMOTE_MODELS=0
SYMON_REQUIRE_ALL_WORKERS=1

# Local model layout.
SYMON_GEMMA_MODEL=models/llm/gemma
SYMON_QWEN_MODEL=models/llm/qwen
SYMON_VISION_MODEL=models/vlm/qwen2_5_vl
SYMON_STABLE_MODEL=models/sd/stable-diffusion
SYMON_VIT_ENCODER_MODEL=models/vlm/vit-encoder

# vLLM CUDA controls.
SYMON_VLLM_DTYPE=auto
SYMON_VLLM_GPU_MEMORY_UTILIZATION=0.82
SYMON_VLLM_MAX_MODEL_LEN=8192
SYMON_VLLM_CPU_OFFLOAD_GB=0
SYMON_VLLM_SWAP_SPACE_GB=4
SYMON_VLLM_QUANTIZATION=
SYMON_VLLM_ENABLE_PREFIX_CACHING=1
SYMON_VLLM_MAX_NUM_SEQS=16
SYMON_VLLM_MAX_NUM_BATCHED_TOKENS=8192
SYMON_VLLM_LIMIT_MM_IMAGES=4

# 16 GB-class guardrails. Increase for A/H/B/datacenter cards.
SYMON_VRAM_TARGET_GB=14.0
SYMON_VRAM_HARD_LIMIT_GB=15.2
SYMON_SINGLE_ACTIVE_MODEL=1
SYMON_UNLOAD_TEXT_BEFORE_IMAGE=1

# SLO-aware flow control.
SYMON_MAX_QUEUE=32
SYMON_MAX_CONCURRENT_TEXT=1
SYMON_MAX_CONCURRENT_IMAGE=1
SYMON_MAX_CONCURRENT_VISION=1
SYMON_SLO_TTFT_MS=2500
SYMON_SLO_ITL_MS=150
SYMON_SLO_IMAGE_MS=45000

# Image defaults.
SYMON_IMAGE_WIDTH=512
SYMON_IMAGE_HEIGHT=512
SYMON_IMAGE_STEPS=24
SYMON_IMAGE_GUIDANCE=7.0
