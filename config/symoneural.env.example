SYMON_BIND_HOST=0.0.0.0
SYMON_BIND_PORT=8000

SYMON_TEXT_BACKEND=vllm
SYMON_VISION_BACKEND=vllm
SYMON_IMAGE_BACKEND=diffusers
SYMON_DEVICE=cuda

SYMON_GEMMA_MODEL=models/llm/gemma-4-12b-it-Q4_K_M.gguf
SYMON_GEMMA_TOKENIZER=google/gemma-4-12B-it
SYMON_GEMMA_HF_CONFIG=google/gemma-4-12B-it

SYMON_QWEN_MODEL=models/llm/qwen2.5-coder-1.5b-instruct-q8_0.gguf
SYMON_QWEN_TOKENIZER=Qwen/Qwen2.5-Coder-1.5B-Instruct
SYMON_QWEN_HF_CONFIG=Qwen/Qwen2.5-Coder-1.5B-Instruct

SYMON_VISION_MODEL=models/vlm/qwen2_5_vl
SYMON_STABLE_MODEL=models/sd/v1-5-pruned-emaonly.safetensors

SYMON_VLLM_DTYPE=float16
SYMON_VLLM_GPU_MEMORY_UTILIZATION=0.82
SYMON_VLLM_MAX_MODEL_LEN=8192
SYMON_VLLM_MAX_NUM_SEQS=1
SYMON_VLLM_MAX_NUM_BATCHED_TOKENS=8192
SYMON_VLLM_ENABLE_PREFIX_CACHING=1

SYMON_SINGLE_ACTIVE_MODEL=1
SYMON_REQUIRE_ALL_WORKERS=0
SYMON_MAX_NEW_TOKENS_DEFAULT=768

SYMON_VRAM_TARGET_GB=14.5
SYMON_VRAM_HARD_LIMIT_GB=15.2

SYMON_VRAM_TEXT_GEMMA_SHARE=0.20
SYMON_VRAM_TEXT_QWEN_SHARE=0.80

SYMON_VRAM_IMAGE_GEMMA_SHARE=0.20
SYMON_VRAM_IMAGE_RUNTIME_SHARE=0.80

SYMON_VRAM_PARAM_GEMMA_SHARE=0.25
SYMON_VRAM_PARAM_QWEN_SHARE=0.05
SYMON_VRAM_PARAM_RUNTIME_SHARE=0.70

SYMON_PARAMETER_GOVERNOR=qwen
