from __future__ import annotations

import os
import re
from dataclasses import dataclass
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[2]
RUNTIME = ROOT / "data" / "runtime"
OUTPUT = ROOT / "data" / "output"
HF_CACHE = ROOT / "data" / "hf-cache"

for path in (RUNTIME, OUTPUT, HF_CACHE):
    path.mkdir(parents=True, exist_ok=True)


def _load_env_file(path: Path) -> bool:
    if not path.is_file():
        return False

    key_re = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")

    for raw in path.read_text(errors="ignore").splitlines():
        line = raw.strip()

        if not line or line.startswith("#"):
            continue

        if line.startswith("export "):
            line = line[len("export ") :].strip()

        if "=" not in line:
            continue

        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()

        if not key_re.match(key):
            continue

        # Strip inline trailing comments like `SYMON_X=1   # explanation`.
        # A comment is a `#` preceded by whitespace. Skip this for values
        # that start with a quote char -- those are handled by the
        # quote-unwrap step below, and a literal '#' inside quotes should
        # not be treated as a comment.
        if not (len(value) >= 1 and value[0] in {"'", '"'}):
            value = re.split(r"\s+#", value, maxsplit=1)[0].rstrip()

        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]

        os.environ.setdefault(key, value)

    return True


_load_env_file(ROOT / ".env")
_load_env_file(ROOT / "config" / "symoneural.env")


def _env_bool(name: str, default: bool) -> bool:
    raw = os.environ.get(name)
    if raw is None or raw.strip() == "":
        return default
    return raw.strip().lower() in {"1", "true", "yes", "y", "on"}


def _env_int(name: str, default: int) -> int:
    raw = os.environ.get(name)
    if raw is None or raw.strip() == "":
        return default
    return int(raw)


def _env_int_first(names: list[str], default: int) -> int:
    for name in names:
        raw = os.environ.get(name)
        if raw is not None and raw.strip() != "":
            return int(raw)
    return default


def _env_float(name: str, default: float) -> float:
    raw = os.environ.get(name)
    if raw is None or raw.strip() == "":
        return default
    return float(raw)


def _env_str(name: str, default: str) -> str:
    raw = os.environ.get(name)
    if raw is None or raw.strip() == "":
        return default
    return raw.strip()


def resolve_local_path(model_ref: str) -> Path:
    path = Path(str(model_ref)).expanduser()
    if not path.is_absolute():
        path = ROOT / path
    return path.resolve()


def looks_like_hf_repo_id(value: str) -> bool:
    value = value.strip()

    if not value:
        return False

    if value.startswith(("/", "./", "../", "~")):
        return False

    if any(ch in value for ch in " \\:"):
        return False

    local_prefixes = (
        "models/",
        "data/",
        "app/",
        "config/",
        "docs/",
        "scripts/",
        "tools/",
    )

    if value.startswith(local_prefixes):
        return False

    parts = value.split("/")
    return len(parts) == 2 and all(parts)


@dataclass(frozen=True)
class ModelRefs:
    gemma: str = _env_str(
        "SYMON_GEMMA_MODEL",
        "models/llm/gemma-4-12b-it-Q4_K_M.gguf",
    )
    qwen: str = _env_str(
        "SYMON_QWEN_MODEL",
        "models/llm/qwen2.5-coder-1.5b-instruct-q8_0.gguf",
    )
    vision: str = _env_str(
        "SYMON_VISION_MODEL",
        "models/vlm/qwen2_5_vl",
    )
    stable: str = _env_str(
        "SYMON_STABLE_MODEL",
        "models/sd/v1-5-pruned-emaonly.safetensors",
    )
    vit_encoder: str = _env_str(
        "SYMON_VIT_ENCODER_MODEL",
        "models/vlm/vit-encoder",
    )


@dataclass(frozen=True)
class RuntimeSettings:
    service_name: str = _env_str("SYMON_SERVICE_NAME", "symoneural_moe")
    bind_host: str = _env_str("SYMON_BIND_HOST", "0.0.0.0")
    bind_port: int = _env_int("SYMON_BIND_PORT", 8000)
    # If set, every request must include "Authorization: Bearer <this value>".
    # Blank (the default) means no auth -- fine for local dev, NOT fine for a
    # publicly reachable server. Set this before exposing the app to the internet.
    api_key: str = _env_str("SYMON_API_KEY", "")

    device: str = _env_str("SYMON_DEVICE", "cuda").lower()
    text_backend: str = _env_str("SYMON_TEXT_BACKEND", "vllm").lower()
    vision_backend: str = _env_str("SYMON_VISION_BACKEND", "vllm").lower()
    image_backend: str = _env_str("SYMON_IMAGE_BACKEND", "diffusers").lower()

    allow_remote_models: bool = _env_bool("SYMON_ALLOW_REMOTE_MODELS", False)
    require_all_workers: bool = _env_bool("SYMON_REQUIRE_ALL_WORKERS", False)

    # Gemma is kept fully wired (worker code, VRAM profiles, routing hooks)
    # but disabled by default -- flip this back to true to reactivate it for
    # this or a future project without touching any code.
    gemma_enabled: bool = _env_bool("SYMON_GEMMA_ENABLED", False)

    # vLLM CUDA text/VLM runtime.
    vllm_dtype: str = _env_str("SYMON_VLLM_DTYPE", "auto")
    vllm_gpu_memory_utilization: float = _env_float("SYMON_VLLM_GPU_MEMORY_UTILIZATION", 0.82)
    vllm_max_model_len: int = _env_int("SYMON_VLLM_MAX_MODEL_LEN", 8192)
    vllm_cpu_offload_gb: float = _env_float("SYMON_VLLM_CPU_OFFLOAD_GB", 0.0)
    vllm_swap_space_gb: float = _env_float("SYMON_VLLM_SWAP_SPACE_GB", 4.0)
    vllm_quantization: str = _env_str("SYMON_VLLM_QUANTIZATION", "")
    vllm_enforce_eager: bool = _env_bool("SYMON_VLLM_ENFORCE_EAGER", False)
    vllm_trust_remote_code: bool = _env_bool("SYMON_VLLM_TRUST_REMOTE_CODE", True)
    vllm_disable_log_stats: bool = _env_bool("SYMON_VLLM_DISABLE_LOG_STATS", True)
    vllm_seed: int = _env_int("SYMON_VLLM_SEED", 0)
    vllm_enable_prefix_caching: bool = _env_bool("SYMON_VLLM_ENABLE_PREFIX_CACHING", True)
    vllm_max_num_seqs: int = _env_int("SYMON_VLLM_MAX_NUM_SEQS", 1)
    vllm_max_num_batched_tokens: int = _env_int("SYMON_VLLM_MAX_NUM_BATCHED_TOKENS", 8192)
    vllm_limit_mm_images: int = _env_int("SYMON_VLLM_LIMIT_MM_IMAGES", 4)

    # Sampling defaults.
    max_new_tokens_default: int = _env_int_first(
        ["SYMON_MAX_NEW_TOKENS_DEFAULT", "SYMON_MAX_NEW_TOKENS"],
        768,
    )
    temperature_chat: float = _env_float("SYMON_TEMPERATURE_CHAT", 0.7)
    temperature_code: float = _env_float("SYMON_TEMPERATURE_CODE", 0.2)
    temperature_vision: float = _env_float("SYMON_TEMPERATURE_VISION", 0.2)
    top_p: float = _env_float("SYMON_TOP_P", 0.95)
    top_k: int = _env_int("SYMON_TOP_K", 64)
    repetition_penalty: float = _env_float("SYMON_REPETITION_PENALTY", 1.05)
    # min_p: alternative to top_p, filters tokens below a probability floor
    # relative to the most likely token. 0 = disabled (vLLM's own default).
    min_p: float = _env_float("SYMON_MIN_P", 0.0)
    # presence_penalty/frequency_penalty: real vLLM SamplingParams fields.
    # presence_penalty flatly discourages any token already used at all;
    # frequency_penalty scales with how many times it's been used. Both
    # 0 = disabled (vLLM's own default).
    presence_penalty: float = _env_float("SYMON_PRESENCE_PENALTY", 0.0)
    frequency_penalty: float = _env_float("SYMON_FREQUENCY_PENALTY", 0.0)

    # KV cache dtype / attention backend (llama.cpp equivalents: --cache-type-k/v, -fa).
    # "auto" lets vLLM pick; "fp8"/"fp8_e5m2" quantizes the KV cache similar in spirit
    # to llama.cpp's q8_0 cache types (not bit-identical, but same VRAM-saving intent).
    vllm_kv_cache_dtype: str = _env_str("SYMON_VLLM_KV_CACHE_DTYPE", "auto")
    # Leave blank to let vLLM auto-select (it already prefers FlashAttention/FlashInfer
    # when available -- this is the vLLM equivalent of llama.cpp's `-fa on`).
    vllm_attention_backend: str = _env_str("SYMON_VLLM_ATTENTION_BACKEND", "")

    # Diffusers image runtime. Defaults sized for SDXL's native 1024x1024;
    # lower these back to 512 in .env if using an SD1.x-family checkpoint.
    image_width: int = _env_int("SYMON_IMAGE_WIDTH", 1024)
    image_height: int = _env_int("SYMON_IMAGE_HEIGHT", 1024)
    image_steps: int = _env_int("SYMON_IMAGE_STEPS", 30)
    image_guidance: float = _env_float("SYMON_IMAGE_GUIDANCE", 7.0)
    # -1 = random seed every generation (default). Set a fixed non-negative
    # integer to make output reproducible across runs with the same prompt.
    image_seed: int = _env_int("SYMON_IMAGE_SEED", -1)
    # "default" leaves the checkpoint's own configured scheduler in place.
    # Recognized names: euler_a, euler, dpm++_2m, dpm++_2m_karras, ddim, unipc.
    image_scheduler: str = _env_str("SYMON_IMAGE_SCHEDULER", "default")
    image_negative_prompt: str = _env_str(
        "SYMON_IMAGE_NEGATIVE_PROMPT",
        "low quality, blurry, distorted, watermark",
    )

    # GPU/VRAM guardrails for one 16 GB class NVIDIA card.
    vram_target_gb: float = _env_float("SYMON_VRAM_TARGET_GB", 14.5)
    vram_hard_limit_gb: float = _env_float("SYMON_VRAM_HARD_LIMIT_GB", 15.2)
    unload_text_before_image: bool = _env_bool("SYMON_UNLOAD_TEXT_BEFORE_IMAGE", True)
    single_active_model: bool = _env_bool("SYMON_SINGLE_ACTIVE_MODEL", True)

    # SyMoNeuRaL MoE VRAM policy.
    vram_text_gemma_share: float = _env_float("SYMON_VRAM_TEXT_GEMMA_SHARE", 0.20)
    vram_text_qwen_share: float = _env_float("SYMON_VRAM_TEXT_QWEN_SHARE", 0.80)

    vram_image_gemma_share: float = _env_float("SYMON_VRAM_IMAGE_GEMMA_SHARE", 0.20)
    vram_image_runtime_share: float = _env_float("SYMON_VRAM_IMAGE_RUNTIME_SHARE", 0.80)

    vram_param_gemma_share: float = _env_float("SYMON_VRAM_PARAM_GEMMA_SHARE", 0.25)
    vram_param_qwen_share: float = _env_float("SYMON_VRAM_PARAM_QWEN_SHARE", 0.05)
    vram_param_runtime_share: float = _env_float("SYMON_VRAM_PARAM_RUNTIME_SHARE", 0.70)

    parameter_governor: str = _env_str("SYMON_PARAMETER_GOVERNOR", "qwen").lower()

    # SLO-aware admission and flow control.
    max_queue: int = _env_int("SYMON_MAX_QUEUE", 32)
    max_concurrent_text: int = _env_int("SYMON_MAX_CONCURRENT_TEXT", 1)
    max_concurrent_image: int = _env_int("SYMON_MAX_CONCURRENT_IMAGE", 1)
    max_concurrent_vision: int = _env_int("SYMON_MAX_CONCURRENT_VISION", 1)
    slo_ttft_ms: int = _env_int("SYMON_SLO_TTFT_MS", 2500)
    slo_itl_ms: int = _env_int("SYMON_SLO_ITL_MS", 150)
    slo_image_ms: int = _env_int("SYMON_SLO_IMAGE_MS", 45000)

    # Prefix-aware routing.
    prefix_cache_chars: int = _env_int("SYMON_PREFIX_CACHE_CHARS", 4096)
    prefix_route_affinity_seconds: int = _env_int("SYMON_PREFIX_ROUTE_AFFINITY_SECONDS", 600)

    def as_dict(self) -> dict[str, Any]:
        return self.__dict__.copy()


MODELS = ModelRefs()
SETTINGS = RuntimeSettings()
