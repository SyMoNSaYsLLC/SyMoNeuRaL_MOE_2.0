[Unit]
Description=SyMoNeuRaL Flagship MoE Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=google
Group=google
WorkingDirectory=/home/google/SyMoNeuRaL_MoE
Environment=SYMON_BIND_HOST=0.0.0.0
Environment=SYMON_BIND_PORT=8000
EnvironmentFile=-/home/google/SyMoNeuRaL_MoE/.env
ExecStart=/home/google/SyMoNeuRaL_MoE/.venv/bin/python -m uvicorn app.main:app --host ${SYMON_BIND_HOST} --port ${SYMON_BIND_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
